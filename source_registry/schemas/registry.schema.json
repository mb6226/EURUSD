{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eurusd-ai-monitor.invalid/schemas/registry.schema.json",
  "title": "Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "source.schema.json"
      }
    }
  }
}
